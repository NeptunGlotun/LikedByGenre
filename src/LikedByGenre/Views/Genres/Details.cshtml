@model IReadOnlyList<Track>
@{
    var group = (GenreGroup)ViewBag.Group;
    ViewData["Title"] = group.Name;
}

<h1>@group.Name</h1>
<p>@Model.Count пісень. Основний артист — перший у списку виконавців трека.</p>

@if (Model.Count > 0)
{
    <form asp-controller="Playlists" asp-action="Export" method="post" class="actions">
        <input type="hidden" name="slug" value="@group.Slug" />
        <button class="button" type="submit">Створити плейлист у Spotify</button>
    </form>
}

<table>
    <thead>
        <tr>
            <th>Пісня</th>
            <th>Артист</th>
            <th>Альбом</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var track in Model)
    {
        var artist = track.TrackArtists.OrderBy(x => x.Order).FirstOrDefault()?.Artist?.Name ?? "—";
        <tr>
            <td>@track.Name</td>
            <td>@artist</td>
            <td>@track.AlbumName</td>
        </tr>
    }
    </tbody>
</table>
