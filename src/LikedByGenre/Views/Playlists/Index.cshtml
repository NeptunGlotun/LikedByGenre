@model IReadOnlyList<PlaylistExport>
@{
    ViewData["Title"] = "Плейлисти";
    var groups = (IReadOnlyList<GenreGroupSummary>)ViewBag.Groups;
}

<h1>Експорт у Spotify</h1>
<p>Кожна кнопка створює новий приватний плейлист. Liked Songs не змінюються.</p>

<div class="actions wrap">
    @foreach (var group in groups.Where(x => x.TrackCount > 0))
    {
        <form asp-action="Export" method="post">
            <input type="hidden" name="slug" value="@group.Slug" />
            <button class="button secondary" type="submit">@group.Name (@group.TrackCount)</button>
        </form>
    }
</div>

<h2>Уже створені</h2>
@if (Model.Count == 0)
{
    <p>Ще немає експортованих плейлистів.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Назва</th>
                <th>Треків</th>
                <th>Коли</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.TrackCount</td>
                <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
            </tr>
        }
        </tbody>
    </table>
}
