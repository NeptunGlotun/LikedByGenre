@model IReadOnlyList<PlaylistExport>
@{
    ViewData["Title"] = "Плейлисти";
    var groups = (IReadOnlyList<GenreGroupSummary>)ViewBag.Groups;
}

<h1>Експорт у Spotify</h1>
<p>Кожна кнопка створює новий приватний плейлист у вашому особистому акаунті Spotify. Liked Songs не змінюються.</p>

<div class="actions wrap">
    @foreach (var group in groups.Where(x => x.TrackCount > 0))
    {
        <form asp-action="Export" method="post">
            <input type="hidden" name="slug" value="@group.Slug" />
            <button class="button secondary" type="submit">@group.Name (@group.TrackCount)</button>
        </form>
    }
</div>

<h2>Уже створені (ваші плейлисти — DAC)</h2>
@if (Model.Count == 0)
{
    <p>Ще немає експортованих плейлистів.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Назва</th>
                <th>Треків</th>
                <th>Власник (DAC)</th>
                <th>Коли</th>
                <th style="text-align: right;">Дії</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.Name</strong></td>
                <td>@item.TrackCount</td>
                <td><code>@item.OwnerSpotifyId</code></td>
                <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                <td style="text-align: right;">
                    <a asp-action="Details" asp-route-id="@item.Id" class="button secondary" style="padding: 4px 10px; font-size: 0.85rem;">Деталі</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display: inline-block;" onsubmit="return confirm('Видалити запис про експорт?');">
                        <button type="submit" class="button" style="padding: 4px 10px; font-size: 0.85rem; background: #dc2626; color: white;">Видалити</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
