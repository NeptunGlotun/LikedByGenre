@{
    ViewData["Title"] = "Вхід до системи";
}

<div class="card" style="max-width: 480px; margin: 40px auto; padding: 24px;">
    <h2>Локальна автентифікація</h2>
    <p style="color: #a0a0a0; font-size: 0.9rem;">
        Введіть облікові дані локального користувача (паролі безпечно перевіряються за алгоритмом BCrypt із сіллю).
    </p>

    <form asp-action="Login" method="post" style="display: flex; flex-direction: column; gap: 14px; margin-top: 16px;">
        @Html.AntiForgeryToken()

        <div>
            <label for="username" style="display: block; margin-bottom: 6px;">Ім'я користувача (Логін):</label>
            <input type="text" id="username" name="username" required 
                   style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #333; background: #1e1e1e; color: #fff;" />
        </div>

        <div>
            <label for="password" style="display: block; margin-bottom: 6px;">Пароль:</label>
            <input type="password" id="password" name="password" required 
                   style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #333; background: #1e1e1e; color: #fff;" />
        </div>

        <button type="submit" class="button" style="margin-top: 10px; width: 100%; text-align: center;">Увійти</button>
    </form>

    <div style="margin-top: 16px; text-align: center;">
        <span style="color: #888;">Немає акаунта?</span>
        <a asp-action="Register" style="color: #1db954; text-decoration: none; font-weight: bold; margin-left: 6px;">Зареєструватися</a>
    </div>

    <div style="display: flex; align-items: center; margin: 24px 0;">
        <hr style="flex: 1; border: none; border-top: 1px solid #333;" />
        <span style="margin: 0 12px; color: #777; font-size: 0.85rem;">АБО</span>
        <hr style="flex: 1; border: none; border-top: 1px solid #333;" />
    </div>

    <div style="text-align: center;">
        <p style="color: #aaa; font-size: 0.85rem; margin-bottom: 12px;">
            Швидкий вхід за допомогою зовнішнього OAuth 2.0 PKCE провайдера:
        </p>
        <a class="button" asp-action="ChallengeSpotify" style="background: #1db954; display: block; width: 100%; text-align: center;">
            Продовжити зі Spotify
        </a>
    </div>
</div>
